{
  "name": "watchquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "start:api": "node server/start.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test tests/api.test.mjs tests/catalogue.test.mjs tests/movie-dna.test.mjs",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "test:setup": "playwright-core install chromium --only-shell"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/montserrat": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
