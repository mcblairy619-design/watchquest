{
  "name": "watchquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "start:api": "npm start --workspace @watchquest/api",
    "build": "npm run build --workspace @watchquest/web",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run check --workspace @watchquest/web",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test tests/api.test.mjs tests/catalogue.test.mjs tests/movie-dna.test.mjs",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "test:setup": "playwright-core install chromium --only-shell"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright-core": "^1.55.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
